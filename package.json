{
  "name": "limeiot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "npm run build:home && cargo build --workspace --locked",
    "build:home": "npm run build --workspace @limeiot/home",
    "check": "cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "cargo test --workspace --locked",
    "test:e2e": "npm run build && node --test tests/e2e.test.mjs tests/nas.test.mjs tests/device-identity.test.mjs",
    "test:ios": "npm run build && node tools/test-native.mjs ios",
    "test:android": "npm run build && node tools/test-native.mjs android",
    "test:firmware": "cargo build --workspace --locked && node tools/test-firmware.mjs",
    "test:provisioning": "node --test tests/provisioning.test.mjs",
    "test:inference": "npm run build && node --test tests/inference.test.mjs",
    "test:inference:live": "npm run build && node tools/test-local-model.mjs",
    "test:control": "node tools/test-control.mjs",
    "test:pairing": "npm run build && node tools/test-control.mjs --gateway-pairing",
    "test:relay": "npm run build && node tools/test-control.mjs --gateway-relay",
    "test:browser": "npm run build && playwright test",
    "dev": "npm run build && node tools/dev.mjs",
    "cli": "node packages/cli/src/main.mjs"
  },
  "workspaces": [
    "packages/cli",
    "apps/home"
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
