{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot.limeai.run/contracts/zigbee-environment.schema.json",
  "title": "ZNP固定环境观测来源配置",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "bindings": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "coordinators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/coordinator"
      }
    }
  },
  "required": [
    "schema_version",
    "bindings"
  ],
  "additionalProperties": false,
  "$defs": {
    "ieee": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "enum": [
          "0000000000000000",
          "ffffffffffffffff"
        ]
      }
    },
    "binding": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "model_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "serial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/[^\\u0000]*$"
        },
        "target": {
          "type": "object",
          "properties": {
            "coordinator_ieee": {
              "$ref": "#/$defs/ieee"
            },
            "ieee_address": {
              "$ref": "#/$defs/ieee"
            },
            "endpoint": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240
            }
          },
          "required": [
            "coordinator_ieee",
            "ieee_address",
            "endpoint"
          ],
          "additionalProperties": false
        },
        "manufacturer_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "signature": {
          "type": "object",
          "properties": {
            "manufacturer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
            },
            "application_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "hardware_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "manufacturer",
            "model",
            "application_version",
            "hardware_version"
          ],
          "additionalProperties": false
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000
        }
      },
      "required": [
        "device_id",
        "adapter_id",
        "model_revision",
        "serial",
        "target",
        "manufacturer_code",
        "signature",
        "timeout_ms",
        "poll_interval_ms"
      ],
      "additionalProperties": false
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "coordinator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "serial": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/[^\\u0000]*$"
        },
        "coordinator_ieee": {
          "$ref": "#/$defs/ieee"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "poll_interval_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 10000
        }
      },
      "required": [
        "coordinator_id",
        "serial",
        "coordinator_ieee",
        "timeout_ms",
        "poll_interval_ms"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {
          "const": 1
        },
        "coordinators": false
      }
    },
    {
      "properties": {
        "schema_version": {
          "const": 2
        }
      },
      "required": [
        "coordinators"
      ]
    }
  ]
}
