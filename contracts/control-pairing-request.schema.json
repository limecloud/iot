{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "本地网关配对审核请求",
  "type": "object",
  "required": ["space_id", "idempotency_key", "control_origin", "pairing_id", "code"],
  "properties": {
    "space_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "control_origin": {"type": "string", "format": "uri", "maxLength": 400},
    "pairing_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "code": {"type": "string", "pattern": "^[a-f0-9]{64}$", "writeOnly": true}
  },
  "additionalProperties": false
}
