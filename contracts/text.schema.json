{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limeiot.dev/contracts/text.schema.json",
  "title": "Local bounded text generation",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "content_digest",
        "expires_at",
        "cleared_at"
      ],
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$",
          "minLength": 1
        },
        "content_digest": {
          "$ref": "#/$defs/hash"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "cleared_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "cleared_at": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "text": {
              "type": "null"
            },
            "cleared_at": {
              "type": "string"
            }
          }
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "revision",
        "model",
        "data_location"
      ],
      "properties": {
        "adapter": {
          "const": "ollama-text-v1"
        },
        "revision": {
          "$ref": "#/$defs/hash"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:./-]{1,128}$"
        },
        "data_location": {
          "const": "local"
        }
      }
    },
    "request_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?(?:Z|[+-]\\d\\d:\\d\\d)$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "messages",
        "retain_seconds",
        "expires_at"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
        },
        "messages": {
          "$ref": "#/$defs/messages"
        },
        "retain_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "expires_at": {
          "$ref": "#/$defs/request_time"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_digest",
        "context_bytes",
        "message_count",
        "retain_seconds",
        "expires_at"
      ],
      "properties": {
        "context_digest": {
          "$ref": "#/$defs/hash"
        },
        "context_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "message_count": {
          "enum": [
            1,
            3,
            5,
            7,
            9,
            11,
            13,
            15
          ]
        },
        "retain_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "expires_at": {
          "$ref": "#/$defs/request_time"
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_id",
        "space_id",
        "idempotency_key",
        "request_digest",
        "input",
        "deployment",
        "created_at",
        "updated_at",
        "status",
        "output",
        "error_code",
        "usage"
      ],
      "properties": {
        "text_id": {
          "type": "string",
          "pattern": "^text-[A-Za-z0-9_-]{1,123}$"
        },
        "space_id": {
          "$ref": "#/$defs/id"
        },
        "idempotency_key": {
          "$ref": "#/$defs/id"
        },
        "request_digest": {
          "$ref": "#/$defs/hash"
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "updated_at": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "unknown",
            "discarded"
          ]
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/output"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/usage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "running"
            },
            "output": {
              "type": "null"
            },
            "error_code": {
              "type": "null"
            },
            "usage": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "succeeded"
            },
            "output": {
              "$ref": "#/$defs/output"
            },
            "error_code": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "failed"
            },
            "output": {
              "type": "null"
            },
            "error_code": {
              "enum": [
                "text_provider_rejected",
                "invalid_text_output",
                "text_output_too_large",
                "text_origin_not_local",
                "text_provider_unavailable"
              ]
            },
            "usage": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "unknown"
            },
            "output": {
              "type": "null"
            },
            "error_code": {
              "enum": [
                "text_provider_unknown",
                "text_deadline_exceeded",
                "text_interrupted"
              ]
            },
            "usage": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "discarded"
            },
            "output": {
              "type": "null"
            },
            "error_code": {
              "enum": [
                "text_output_discarded"
              ]
            },
            "usage": {
              "type": "null"
            }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "userMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "user"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "assistantMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "content"
      ],
      "properties": {
        "role": {
          "const": "assistant"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      }
    },
    "messages": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "prefixItems": [
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            },
            {
              "$ref": "#/$defs/assistantMessage"
            },
            {
              "$ref": "#/$defs/userMessage"
            }
          ],
          "items": false
        }
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      }
    }
  }
}
