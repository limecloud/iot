{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT 0.1 local rule draft request",
  "type": "object",
  "required": ["space_id", "idempotency_key", "prompt", "expires_at"],
  "properties": {
    "space_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 512 },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
