{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT model validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "validator",
    "valid",
    "document_digest",
    "model_revision",
    "normalized_model",
    "issues"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "validator": {
      "enum": [
        "limeiot.model/1.0.0",
        "limeiot.model/1.1.0"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "document_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalized_model": {
      "type": [
        "object",
        "null"
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "document_digest": {
            "type": "string"
          },
          "model_revision": {
            "type": "string"
          },
          "normalized_model": {
            "$ref": "./model.schema.json"
          },
          "issues": {
            "maxItems": 0,
            "type": "array"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "model_revision": {
            "type": "null"
          },
          "normalized_model": {
            "type": "null"
          },
          "issues": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
