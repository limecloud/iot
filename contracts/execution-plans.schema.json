{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT bounded execution plans",
  "$ref": "#/$defs/change",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time"},
    "nullable_time": {"anyOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
    "nullable_string": {"type": ["string", "null"]},
    "path": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}\\.[a-z][a-z0-9_-]{0,63}$"},
    "device_operation": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "path", "value"],
      "properties": {"type": {"enum": ["property.set", "action.invoke"]}, "path": {"$ref": "#/$defs/path"}, "value": {}}
    },
    "completion": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "command"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "path", "timeout_ms"], "properties": {
          "type": {"const": "event"}, "path": {"$ref": "#/$defs/path"}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 900000}
        }}
      ]
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "device_id", "model_revision", "operation", "command_timeout_ms", "completion"],
      "properties": {
        "step_id": {"$ref": "#/$defs/id"}, "device_id": {"$ref": "#/$defs/id"}, "model_revision": {"$ref": "#/$defs/digest"},
        "operation": {"$ref": "#/$defs/device_operation"}, "command_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000},
        "completion": {"$ref": "#/$defs/completion"}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["steps"],
      "properties": {"steps": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/step"}}}
    },
    "create": {
      "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "generation", "stages", "expires_at"],
      "properties": {
        "type": {"const": "plans.create"}, "plan_id": {"$ref": "#/$defs/id"}, "generation": {"$ref": "#/$defs/id"},
        "stages": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/stage"}}, "expires_at": {"$ref": "#/$defs/time"}
      }
    },
    "start": {
      "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "expected_revision"],
      "properties": {"type": {"const": "plans.start"}, "plan_id": {"$ref": "#/$defs/id"}, "expected_revision": {"$ref": "#/$defs/digest"}}
    },
    "cancel": {
      "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "expected_revision"],
      "properties": {"type": {"const": "plans.cancel"}, "plan_id": {"$ref": "#/$defs/id"}, "expected_revision": {"$ref": "#/$defs/digest"}}
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["type", "plan_id", "expected_revision"],
      "properties": {"type": {"const": "plans.release"}, "plan_id": {"$ref": "#/$defs/id"}, "expected_revision": {"$ref": "#/$defs/digest"}}
    },
    "change": {"oneOf": [{"$ref": "#/$defs/create"}, {"$ref": "#/$defs/start"}, {"$ref": "#/$defs/cancel"}, {"$ref": "#/$defs/release"}]},
    "request": {
      "type": "object", "additionalProperties": false, "required": ["space_id", "idempotency_key", "change"],
      "properties": {"space_id": {"$ref": "#/$defs/id"}, "idempotency_key": {"$ref": "#/$defs/id"}, "change": {"$ref": "#/$defs/change"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["device_id", "model_revision", "boot_id", "session_id"],
      "properties": {"device_id": {"$ref": "#/$defs/id"}, "model_revision": {"$ref": "#/$defs/digest"}, "boot_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"}}
    },
    "device_event": {
      "type": "object", "additionalProperties": false,
      "required": ["device_id", "model_revision", "boot_id", "session_id", "message_id", "seq", "event_id", "path", "occurred_at", "received_at", "body_digest", "data"],
      "properties": {
        "device_id": {"$ref": "#/$defs/id"}, "model_revision": {"$ref": "#/$defs/digest"}, "boot_id": {"$ref": "#/$defs/id"}, "session_id": {"$ref": "#/$defs/id"},
        "message_id": {"$ref": "#/$defs/id"}, "seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "event_id": {"$ref": "#/$defs/id"},
        "path": {"$ref": "#/$defs/path"}, "occurred_at": {"$ref": "#/$defs/time"}, "received_at": {"$ref": "#/$defs/time"}, "body_digest": {"$ref": "#/$defs/digest"}, "data": {}
      }
    },
    "child": {
      "type": "object", "additionalProperties": false, "required": ["stage_index", "step_id", "command_id", "event_deadline", "event"],
      "properties": {
        "stage_index": {"type": "integer", "minimum": 0, "maximum": 15}, "step_id": {"$ref": "#/$defs/id"}, "command_id": {"$ref": "#/$defs/id"},
        "event_deadline": {"$ref": "#/$defs/nullable_time"}, "event": {"anyOf": [{"$ref": "#/$defs/device_event"}, {"type": "null"}]}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "generation", "revision", "definition_digest", "stages", "bindings", "expires_at", "created_at", "started_at", "ended_at", "status", "reason", "current_stage", "children", "physical_stop", "released"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/id"}, "generation": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/digest"}, "definition_digest": {"$ref": "#/$defs/digest"},
        "stages": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/stage"}},
        "bindings": {"type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/binding"}},
        "expires_at": {"$ref": "#/$defs/time"}, "created_at": {"$ref": "#/$defs/time"}, "started_at": {"$ref": "#/$defs/nullable_time"}, "ended_at": {"$ref": "#/$defs/nullable_time"},
        "status": {"enum": ["draft", "running", "completed", "failed", "partial", "cancelled", "unknown"]}, "reason": {"$ref": "#/$defs/nullable_string"},
        "current_stage": {"type": "integer", "minimum": 0, "maximum": 16}, "children": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/child"}},
        "physical_stop": {"enum": ["not_requested", "unknown"]}, "released": {"type": "boolean"}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision"],
      "properties": {"kind": {"const": "execution_plan"}, "id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/digest"}}
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "request", "request_digest", "status", "reason", "result", "created_at"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/id"}, "request": {"$ref": "#/$defs/request"}, "request_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["applied", "conflict", "rejected"]}, "reason": {"$ref": "#/$defs/nullable_string"},
        "result": {"anyOf": [{"$ref": "#/$defs/resource"}, {"type": "null"}]}, "created_at": {"$ref": "#/$defs/time"}
      }
    }
  }
}
