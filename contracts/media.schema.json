{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limeiot.run/contracts/media.schema.json",
  "title": "Local bounded PCM audio changes and receipts",
  "$comment": "Schema只校验结构；运行时另核对WAV完整性、容量、绑定、权限、期限和耐久结果。operation是历史决定，不能用来判断当前授权。",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "audio": {
      "type": "object",
      "properties": {
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 48000
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "bits_per_sample": {
          "const": 16
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2880000
        }
      },
      "required": [
        "sample_rate",
        "channels",
        "bits_per_sample",
        "frames"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "media_id": {
          "$ref": "#/$defs/identifier"
        },
        "space_id": {
          "$ref": "#/$defs/identifier"
        },
        "content_type": {
          "const": "audio/wav"
        },
        "purpose": {
          "const": "device_playback"
        },
        "actor": {
          "const": "local_owner"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 46,
          "maximum": 4194304
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        }
      },
      "required": [
        "media_id",
        "space_id",
        "content_type",
        "purpose",
        "actor",
        "byte_length",
        "content_digest",
        "audio",
        "created_at",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "upload": {
      "type": "object",
      "properties": {
        "type": {
          "const": "media.upload"
        },
        "content_base64": {
          "type": "string",
          "minLength": 64,
          "maxLength": 5592408,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "retain_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        }
      },
      "required": [
        "type",
        "content_base64",
        "retain_seconds"
      ],
      "additionalProperties": false
    },
    "delete": {
      "type": "object",
      "properties": {
        "type": {
          "const": "media.delete"
        },
        "media_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "type",
        "media_id"
      ],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "type": {
          "const": "media.grant"
        },
        "media_id": {
          "$ref": "#/$defs/identifier"
        },
        "device_id": {
          "$ref": "#/$defs/identifier"
        },
        "expected_binding_revision": {
          "$ref": "#/$defs/digest"
        },
        "valid_for_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600
        }
      },
      "required": [
        "type",
        "media_id",
        "device_id",
        "expected_binding_revision",
        "valid_for_seconds"
      ],
      "additionalProperties": false
    },
    "revoke": {
      "type": "object",
      "properties": {
        "type": {
          "const": "media.revoke"
        },
        "grant_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "type",
        "grant_id"
      ],
      "additionalProperties": false
    },
    "change": {
      "oneOf": [
        {
          "$ref": "#/$defs/upload"
        },
        {
          "$ref": "#/$defs/delete"
        },
        {
          "$ref": "#/$defs/grant"
        },
        {
          "$ref": "#/$defs/revoke"
        }
      ]
    },
    "uploaded": {
      "type": "object",
      "properties": {
        "type": {
          "const": "uploaded"
        },
        "media": {
          "$ref": "#/$defs/metadata"
        }
      },
      "required": [
        "type",
        "media"
      ],
      "additionalProperties": false
    },
    "deleted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "deleted"
        },
        "media_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "type",
        "media_id"
      ],
      "additionalProperties": false
    },
    "granted": {
      "type": "object",
      "properties": {
        "type": {
          "const": "granted"
        },
        "grant_id": {
          "$ref": "#/$defs/identifier"
        },
        "media_id": {
          "$ref": "#/$defs/identifier"
        },
        "device_id": {
          "$ref": "#/$defs/identifier"
        },
        "binding_revision": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "issued_in_process": {
          "type": "boolean",
          "description": "只表示回执由当前进程签发；撤销或过期后也可为true。当前状态须查询media列表。"
        }
      },
      "required": [
        "type",
        "grant_id",
        "media_id",
        "device_id",
        "binding_revision",
        "created_at",
        "expires_at",
        "issued_in_process"
      ],
      "additionalProperties": false
    },
    "revoked": {
      "type": "object",
      "properties": {
        "type": {
          "const": "revoked"
        },
        "grant_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "type",
        "grant_id"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "idempotency_key": {
          "$ref": "#/$defs/identifier"
        },
        "request_digest": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "media.upload",
            "media.delete",
            "media.grant",
            "media.revoke"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/uploaded"
            },
            {
              "$ref": "#/$defs/deleted"
            },
            {
              "$ref": "#/$defs/granted"
            },
            {
              "$ref": "#/$defs/revoked"
            }
          ]
        },
        "space_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "operation_id",
        "idempotency_key",
        "request_digest",
        "kind",
        "created_at",
        "result",
        "space_id"
      ],
      "additionalProperties": false
    },
    "pull": {
      "type": "object",
      "properties": {
        "prepared_at": {
          "$ref": "#/$defs/time"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD"
          ]
        },
        "range_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194303
        },
        "range_end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194303
        },
        "status": {
          "enum": [
            200,
            206
          ]
        }
      },
      "required": [
        "prepared_at",
        "method",
        "range_start",
        "range_end",
        "status"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "available": {
          "type": "boolean"
        },
        "deleted_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metadata",
        "available",
        "deleted_at"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "grant_id": {
          "$ref": "#/$defs/identifier"
        },
        "media_id": {
          "$ref": "#/$defs/identifier"
        },
        "device_id": {
          "$ref": "#/$defs/identifier"
        },
        "binding_revision": {
          "$ref": "#/$defs/digest"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "expires_at": {
          "$ref": "#/$defs/time"
        },
        "active_in_process": {
          "type": "boolean"
        },
        "binding_current": {
          "type": "boolean"
        },
        "revoked_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "pulls": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/pull"
          }
        }
      },
      "required": [
        "grant_id",
        "media_id",
        "device_id",
        "binding_revision",
        "created_at",
        "expires_at",
        "active_in_process",
        "binding_current",
        "revoked_at",
        "pulls"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "grants": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/authorization"
          }
        },
        "next_cursor": {
          "type": "null"
        },
        "space_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "configured",
        "items",
        "grants",
        "next_cursor",
        "space_id"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/change"
}
