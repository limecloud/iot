{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT 0.1 rule.schema.json",
  "type": "object",
  "required": [
    "version",
    "id",
    "trigger",
    "conditions",
    "actions",
    "cooldown_ms"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trigger": {
      "type": "object",
      "required": [
        "device",
        "event"
      ],
      "properties": {
        "device": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "device",
          "set"
        ],
        "properties": {
          "device": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "set": {
            "type": "object",
            "required": [
              "path",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "value": {}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "cooldown_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  },
  "additionalProperties": false
}
