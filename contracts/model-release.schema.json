{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT signed model release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "algorithm",
    "signing_key_id",
    "statement",
    "signature"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "publisher_id",
        "namespace",
        "product_id",
        "release_id",
        "source_revision",
        "source_document_digest",
        "visibility",
        "validator",
        "compatibility_checker",
        "model_revision",
        "model",
        "baseline",
        "published_at"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "publisher_id": {
          "type": "string",
          "pattern": "^publisher-[a-f0-9]{64}$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^p-[a-f0-9]{30}$"
        },
        "product_id": {
          "type": "string",
          "pattern": "^product-[a-f0-9]{64}$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^release-[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^prodrev-[a-f0-9]{64}$"
        },
        "source_document_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "visibility": {
          "const": "public"
        },
        "validator": {
          "enum": [
            "limeiot.model/1.0.0",
            "limeiot.model/1.1.0"
          ]
        },
        "compatibility_checker": {
          "enum": [
            "limeiot.model-compatibility/1.0.0",
            "limeiot.model-compatibility/1.1.0"
          ]
        },
        "model_revision": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "model": {
          "$ref": "./model.schema.json"
        },
        "baseline": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "release_id",
            "model_revision",
            "model_version"
          ],
          "properties": {
            "release_id": {
              "type": "string",
              "pattern": "^release-[a-f0-9]{64}$"
            },
            "model_revision": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "model_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            }
          }
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
