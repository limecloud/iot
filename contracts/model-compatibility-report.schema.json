{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LimeIoT model compatibility report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "checker",
    "valid",
    "compatible",
    "comparison_digest",
    "baseline",
    "candidate",
    "issues"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "checker": {
      "enum": [
        "limeiot.model-compatibility/1.0.0",
        "limeiot.model-compatibility/1.1.0"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "compatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "comparison_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidate": {
      "type": [
        "object",
        "null"
      ]
    },
    "issues": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "code"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparison_digest": {
            "type": "null"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "baseline": {
            "type": "null"
          },
          "candidate": {
            "type": "null"
          },
          "valid": {
            "const": false
          },
          "compatible": {
            "type": "null"
          },
          "issues": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "baseline": {
            "$ref": "./model-validation-report.schema.json"
          },
          "candidate": {
            "$ref": "./model-validation-report.schema.json"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "baseline": {
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  },
                  "type": "object"
                },
                "candidate": {
                  "properties": {
                    "valid": {
                      "const": true
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "then": {
              "properties": {
                "valid": {
                  "const": true
                }
              },
              "type": "object"
            },
            "else": {
              "properties": {
                "valid": {
                  "const": false
                }
              },
              "type": "object"
            }
          }
        ],
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "valid": {
            "const": true
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "compatible": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "compatible": {
            "type": "null"
          },
          "issues": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "compatible": {
            "const": true
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "valid": {
            "const": true
          },
          "issues": {
            "maxItems": 0,
            "type": "array"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "issues": {
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
