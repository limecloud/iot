{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design MQTT result fixture",
  "type": "object",
  "required": [
    "v",
    "kind",
    "message_id",
    "device_id",
    "model_revision",
    "session_id",
    "body",
    "boot_id",
    "seq"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "result"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "body": {
      "type": "object",
      "required": [
        "command_id",
        "status",
        "evidence"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "enum": [
            "acknowledged",
            "confirmed",
            "failed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "device_result",
                "state_readback",
                "sent_only"
              ]
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reported": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false
}
