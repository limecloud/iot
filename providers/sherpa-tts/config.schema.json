{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limeiot.dev/providers/sherpa-tts/config.schema.json",
  "title": "Local sherpa VITS provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "voices", "threads", "rule_fsts", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_:./-]{1,128}$"},
    "voices": {
      "type": "object", "minProperties": 1, "maxProperties": 32,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1023}
    },
    "threads": {"type": "integer", "minimum": 1, "maximum": 4},
    "rule_fsts": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["phone.fst", "date.fst", "number.fst"]}},
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["model.onnx", "lexicon.txt", "tokens.txt"],
      "properties": {
        "model.onnx": {"$ref": "#/$defs/hash"},
        "lexicon.txt": {"$ref": "#/$defs/hash"},
        "tokens.txt": {"$ref": "#/$defs/hash"},
        "phone.fst": {"$ref": "#/$defs/hash"},
        "date.fst": {"$ref": "#/$defs/hash"},
        "number.fst": {"$ref": "#/$defs/hash"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"rule_fsts": {"type": "array", "contains": {"const": "phone.fst"}}}}, "then": {"properties": {"files": {"type": "object", "properties": {"phone.fst": true}, "required": ["phone.fst"]}}}, "else": {"properties": {"files": {"type": "object", "properties": {"phone.fst": false}}}}},
    {"if": {"properties": {"rule_fsts": {"type": "array", "contains": {"const": "date.fst"}}}}, "then": {"properties": {"files": {"type": "object", "properties": {"date.fst": true}, "required": ["date.fst"]}}}, "else": {"properties": {"files": {"type": "object", "properties": {"date.fst": false}}}}},
    {"if": {"properties": {"rule_fsts": {"type": "array", "contains": {"const": "number.fst"}}}}, "then": {"properties": {"files": {"type": "object", "properties": {"number.fst": true}, "required": ["number.fst"]}}}, "else": {"properties": {"files": {"type": "object", "properties": {"number.fst": false}}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
